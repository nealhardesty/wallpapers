<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online wallpapers' hosts (Bing, CelesTrak, the place-name geocoder);
         nothing else goes out (SPEC §1). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Use my location" (Satellites), asked for from the settings screen only:
         the last known position, rounded to 0.1° (SPEC §10.1). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Jellyfin (SPEC §10.21): your own server, usually on the home network,
         which Android 17 guards with a runtime permission. Asked for from the
         settings screen when you connect to a server. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- The launcher icon opens the panel; it can also set the wallpaper. -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LiveWallpaper"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
