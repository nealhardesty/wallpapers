{
  "manifest_version": 3,
  "name": "Wallpapers",
  "version": "0.9.0",
  "description": "Animated wallpapers on every new tab: snow, rain, fireflies, a fish tank, a self-playing 8-bit adventure and more.",
  "homepage_url": "https://github.com/nealhardesty/wallpapers",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "host_permissions": ["https://www.bing.com/*", "https://celestrak.org/*", "https://geocoding-api.open-meteo.com/*", "https://marine-api.open-meteo.com/*", "https://stream.wikimedia.org/*"]
}
